{
  "name": "appsec-academy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --noEmit && node --import tsx scripts/check-quiz.mjs --ci && node --import tsx scripts/check-sinks.mjs --ci && node --import tsx scripts/check-games.mjs --ci",
    "quiz": "node --import tsx scripts/check-quiz.mjs --by-module",
    "sinks": "node --import tsx scripts/check-sinks.mjs",
    "games": "node --import tsx scripts/check-games.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@types/mdx": "^2.0.14",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "prismjs": "^1.30.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^5.4.21"
  }
}
