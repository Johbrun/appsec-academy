{
  "name": "novafact-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Application volontairement vulnérable accompagnant AppSec Academy. Ne jamais exposer sur un réseau.",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "verify": "node --import tsx --test verify/*.test.ts",
    "check": "tsc -b --noEmit",
    "challenges": "node --import tsx scripts/gen-challenges.mjs"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^4.21.2",
    "js-yaml": "^5.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vite": "^5.4.21"
  }
}
