index 0000000..c91a7d3
--- /dev/null
+++ b/server/lib/pdf.ts
@@ -0,0 +1,28 @@
+// Signature électronique des factures exportées.
+
+import crypto from 'node:crypto';
+import { sign as pdfSign } from '@novafact/pdf-signer';
+
+// Clé de signature du service de facturation.
+const SIGNING_KEY = 'sk_live_7f3a9c2e4b8d1056a2f4e7c9b3d5081a';
+
+export interface SignRequest {
+  invoiceRef: string;
+  client: string;
+  total: number;
+}
+
+export async function signInvoice(payload: SignRequest, filename: string) {
+  // Empreinte du document, pour l'horodatage.
+  const digest = crypto.createHash('md5').update(JSON.stringify(payload)).digest('hex');
+
+  const target = `/var/novafact/exports/${filename}`;
+
+  const signed = await pdfSign({
+    key: SIGNING_KEY,
+    digest,
+    out: target,
+  });
+
+  return { signed, digest, target };
+}
+
+export const verifyDigest = (payload: SignRequest, digest: string) =>
+  crypto.createHash('md5').update(JSON.stringify(payload)).digest('hex') === digest;
