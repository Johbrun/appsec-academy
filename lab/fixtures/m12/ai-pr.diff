+++ b/package.json
@@ -14,6 +14,8 @@
     "ajv": "^8.20.0",
     "ajv-formats": "^3.0.1",
     "express": "^4.21.2",
+    "argon2": "^0.41.1",
+    "@novafact/pdf-signer": "^2.3.0",
     "js-yaml": "^5.4.2",
