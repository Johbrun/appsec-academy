{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://novafact.example/schemas/openvex-0.2.0.json",
  "title": "OpenVEX 0.2.0 (profil du lab)",
  "description": "Profil restreint d’OpenVEX. La contrainte qui compte : un statut « not_affected » exige une justification prise dans une liste fermée, et un statut « affected » exige un action_statement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@context",
    "@id",
    "author",
    "timestamp",
    "version",
    "statements"
  ],
  "properties": {
    "@context": {
      "const": "https://openvex.dev/ns/v0.2.0"
    },
    "@id": {
      "type": "string",
      "minLength": 8
    },
    "author": {
      "type": "string",
      "minLength": 3
    },
    "role": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "tooling": {
      "type": "string"
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vulnerability",
          "products",
          "status"
        ],
        "properties": {
          "@id": {
            "type": "string"
          },
          "vulnerability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^CVE-\\d{4}-\\d{4,}$"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "products": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "@id"
              ],
              "properties": {
                "@id": {
                  "type": "string",
                  "pattern": "^pkg:"
                },
                "identifiers": {
                  "type": "object"
                }
              }
            }
          },
          "status": {
            "enum": [
              "not_affected",
              "affected",
              "fixed",
              "under_investigation"
            ]
          },
          "justification": {
            "enum": [
              "component_not_present",
              "vulnerable_code_not_present",
              "vulnerable_code_not_in_execute_path",
              "vulnerable_code_cannot_be_controlled_by_adversary",
              "inline_mitigations_already_exist"
            ]
          },
          "impact_statement": {
            "type": "string",
            "minLength": 1
          },
          "action_statement": {
            "type": "string",
            "minLength": 1
          },
          "action_statement_timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status_notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not_affected"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "justification"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "affected"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "action_statement"
              ]
            }
          },
          {
            "if": {
              "anyOf": [
                {
                  "properties": {
                    "status": {
                      "const": "fixed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                {
                  "properties": {
                    "status": {
                      "const": "under_investigation"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              ]
            },
            "then": {
              "not": {
                "required": [
                  "justification"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
