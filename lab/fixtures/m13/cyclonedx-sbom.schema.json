{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://novafact.example/schemas/cyclonedx-1.6-sbom.json",
  "title": "CycloneDX 1.6 — profil SBOM du lab",
  "description": "Profil restreint de CycloneDX. Le schéma complet est publié en draft-07 et exige d'enregistrer en plus les méta-schémas spdx et jsf ; ce profil couvre ce que le challenge note.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bomFormat", "specVersion", "version", "metadata", "components"],
  "properties": {
    "bomFormat": { "const": "CycloneDX" },
    "specVersion": { "enum": ["1.5", "1.6"] },
    "serialNumber": { "type": "string", "pattern": "^urn:uuid:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "version": { "type": "integer", "minimum": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "component"],
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "lifecycles": { "type": "array" },
        "tools": {},
        "authors": { "type": "array" },
        "supplier": { "type": "object" },
        "component": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "version"],
          "properties": {
            "bom-ref": { "type": "string" },
            "type": { "enum": ["application", "framework", "library", "container", "platform", "device", "firmware", "file"] },
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "purl": { "type": "string", "pattern": "^pkg:" },
            "description": { "type": "string" },
            "licenses": { "type": "array" },
            "supplier": { "type": "object" },
            "externalReferences": { "type": "array" }
          }
        },
        "properties": { "type": "array" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "version", "purl"],
        "properties": {
          "bom-ref": { "type": "string" },
          "type": { "enum": ["application", "framework", "library", "container", "platform", "device", "firmware", "file"] },
          "name": { "type": "string", "minLength": 1 },
          "group": { "type": "string" },
          "version": { "type": "string", "minLength": 1 },
          "purl": { "type": "string", "pattern": "^pkg:npm/" },
          "scope": { "enum": ["required", "optional", "excluded"] },
          "description": { "type": "string" },
          "licenses": { "type": "array" },
          "hashes": { "type": "array" },
          "externalReferences": { "type": "array" },
          "properties": { "type": "array" }
        }
      }
    },
    "dependencies": { "type": "array" },
    "compositions": { "type": "array" }
  }
}
